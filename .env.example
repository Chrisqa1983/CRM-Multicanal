# Entorno de Base de Datos PostgreSQL (requiere pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_db

# URLs de la Aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000
WEBHOOK_PUBLIC_URL=

# Conexión Zernio API (WhatsApp / Instagram / Facebook)
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
ZERNIO_DEFAULT_ACCOUNT_ID=
ZERNIO_BASE_URL=https://api.zernio.com

# OpenRouter (IA & RAG Embeddings)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=google/gemini-2.5-flash
AI_FALLBACK_MODEL=anthropic/claude-3.5-haiku
EMBEDDINGS_MODEL=openai/text-embedding-3-small

# Notificaciones por Email (Resend o SMTP)
RESEND_API_KEY=
RESEND_FROM=Zernio CRM Pro <onboarding@resend.dev>
EMAIL_FROM=Zernio CRM Pro <no-reply@zernio.com>

# Modo Simulación (Sandbox para desarrollo)
SIMULATION_MODE=false
